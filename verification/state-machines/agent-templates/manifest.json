{
  "name": "agent-templates",
  "machines": [
    "A01",
    "A02"
  ],
  "models": [
    {
      "spec": "Wizard.tla",
      "config": "Wizard.cfg",
      "invariants": [
        "DefaultPreserved"
      ]
    },
    {
      "spec": "Hitl.tla",
      "config": "Hitl.cfg",
      "invariants": [
        "NoSummaryOnEOF"
      ]
    }
  ],
  "checks": [
    {
      "command": [
        "python3",
        "verification/state-machines/agent-templates/check.py"
      ],
      "success": "PASS_AGENT_TEMPLATES"
    }
  ],
  "findings": [{
    "name": "wizard-suppressed-copy-loses-default",
    "check": {"command": ["python3", "verification/state-machines/agent-templates/replay-copy-fault.py"], "success": "REPLAYED_WIZARD_SUPPRESSED_COPY_LOSS"},
    "spec": "Wizard.tla", "config": "WizardIOFault.cfg", "invariant": "DefaultPreserved"
  }],
  "mutants": [
    {
      "name": "lose-saved-default",
      "check": 0,
      "code": {
        "path": ".agents/skills/wizard/template.sh",
        "old": "  read -r input || true\n  [[ -z \"$input\" && -n \"$current\" ]] && input=\"$current\"",
        "new": "  read -r input || true\n  [[ -z \"$input\" && -n \"$current\" ]] && input=\"\""
      },
      "failure": "FAIL_AGENT_TEMPLATES",
      "model": {
        "spec": "Wizard.tla",
        "old": "IF input = \"empty\" THEN saved[\"public\"] ELSE IF input = \"eof\" THEN saved[\"public\"] ELSE \"new\"",
        "new": "IF input = \"empty\" THEN \"none\" ELSE IF input = \"eof\" THEN saved[\"public\"] ELSE \"new\"",
        "invariant": "DefaultPreserved"
      }
    },
    {
      "name": "report-incomplete-capture",
      "check": 0,
      "code": {
        "path": ".agents/skills/diagnosing-bugs/scripts/hitl-loop.template.sh",
        "old": "  read -r -p \"    > \" answer",
        "new": "  answer=\"\"\n  read -r -p \"    > \" answer || true"
      },
      "failure": "FAIL_AGENT_TEMPLATES",
      "model": {
        "spec": "Hitl.tla",
        "old": "IF input' = \"line\" THEN \"summary\" ELSE \"aborted\"",
        "new": "IF input' = \"line\" THEN \"summary\" ELSE \"summary\"",
        "invariant": "NoSummaryOnEOF"
      }
    }
  ]
}
